<mujoco model="so_arm100 scene">
  <include file="so_arm100.xml"/>

  <statistic center="0.1 -0.01 0.05" extent="0.5"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="45" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 -0.4 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    
    <!-- Camera for VLA Model -->
    <!-- Positioned above the workspace (Further Negative Y-axis), looking down -->
    <camera name="top_cam" pos="0 -0.4 0.6" mode="fixed" zaxis="0 0 1"/>

    <!-- Chip Box Lid (Static base for the cube) -->
    <body name="chip_box_lid" pos="0.0 -0.4 0.01">
      <geom type="cylinder" size="0.05 0.01" rgba="0.5 0.5 0.5 1"/>
    </body>

    <!-- Target Object: Orange Cube -->
    <!-- Sits on top of the lid (lid z=0.01 + cube half-height 0.02 = 0.03) -->
    <body name="orange_cube" pos="0.0 -0.4 0.03">
      <freejoint/>
      <geom type="box" size="0.02 0.02 0.02" rgba="1 0.5 0 1" mass="0.05" friction="1 0.005 0.0001"/>
    </body>
  </worldbody>
</mujoco>
