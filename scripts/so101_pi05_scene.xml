<mujoco model="so101_pi05_scene">
  <!-- Matches the felixmayor/pi05_so101_orange_cube fine-tune distribution:
       SO-ARM100/101 on a tabletop, single orange cube to pick. Lighting/colors
       chosen to look like the consumer-grade dataset (bright table, simple background). -->
  <compiler angle="radian" autolimits="true"/>

  <include file="../dependencies/mujoco_menagerie/trs_so_arm100/so_arm100.xml"/>

  <!-- Viewer opening pose: 3/4 rear-left of arm, framing arm + tabletop + orange cube. -->
  <statistic center="0.02 -0.15 0.08" extent="0.55"/>

  <visual>
    <headlight diffuse="0.55 0.55 0.55" ambient="0.4 0.4 0.4" specular="0.05 0.05 0.05"/>
    <global azimuth="210" elevation="-22"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="flat" rgb1="0.9 0.9 0.92" rgb2="0.9 0.9 0.92" width="256" height="256"/>
    <material name="table_mat" rgba="0.85 0.82 0.75 1" specular="0.1" shininess="0.2"/>
    <material name="floor_mat" rgba="0.75 0.75 0.78 1"/>
  </asset>

  <worldbody>
    <light pos="0.0 -0.3 1.3" dir="0 0 -1" directional="true" diffuse="0.55 0.55 0.5"/>
    <light pos="0.4 -0.2 0.8" dir="-0.3 -0.2 -0.8" diffuse="0.25 0.25 0.22"/>

    <geom name="floor" type="plane" size="3 3 0.05" material="floor_mat"/>

    <!-- Light tabletop covering the workspace; SO-ARM base sits on it at origin. -->
    <body name="table" pos="0 -0.15 -0.005">
      <geom type="box" size="0.3 0.25 0.005" material="table_mat"/>
    </body>

    <!-- Orange cube target (matches "orange cube" task in the fine-tune name). -->
    <body name="orange_cube" pos="0.05 -0.28 0.02">
      <joint type="free"/>
      <geom type="box" size="0.015 0.015 0.015" rgba="1.0 0.55 0.05 1" mass="0.04"/>
    </body>

    <!-- 3rd-person camera mimicking the SO-101 phone-camera setup used by hobbyist datasets. -->
    <camera name="vla_view" pos="0.0 -0.45 0.30" mode="targetbody" target="orange_cube" fovy="55"/>
    <!-- top_cam: alias used by the pi05_minimax_vla pipeline for the primary view. -->
    <camera name="top_cam" pos="0.0 -0.45 0.30" mode="targetbody" target="orange_cube" fovy="55"/>
  </worldbody>

  <keyframe>
    <!-- nq = 6 arm + 7 free joint (cube) = 13. nu = 6. -->
    <key name="pi05_home"
         qpos="0 -1.57 1.57 1.57 -1.57 0  0.05 -0.28 0.02 1 0 0 0"
         ctrl="0 -1.57 1.57 1.57 -1.57 0"/>
  </keyframe>
</mujoco>
