<mujoco model="panda scene">
  <!-- 显式指定 mesh 资源目录，解决相对路径问题 -->
  <compiler angle="radian" meshdir="../mujoco_menagerie/franka_emika_panda/assets" autolimits="true"/>

  <!-- 引入 Menagerie 中的 Panda 机器人 -->
  <include file="../mujoco_menagerie/franka_emika_panda/panda.xml"/>

  <statistic center="0.3 0 0.4" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- 添加一个桌子 -->
    <body name="table" pos="0.5 0 0.2">
        <geom type="box" size="0.3 0.3 0.2" rgba="0.5 0.5 0.5 1"/>
    </body>

    <!-- 添加一个红色方块 (目标物体) -->
    <!-- 添加 free joint 使其可以被移动 -->
    <body name="box" pos="0.5 0 0.5">
        <joint type="free"/>
        <geom type="box" size="0.02 0.02 0.02" rgba="1 0 0 1" mass="0.1"/>
    </body>

    <!-- Fixed 3rd-person camera for VLA: mimics Bridge-V2 over-the-shoulder shot.
         Pose: in front-right of the arm, slightly above the table, pointed at the workspace. -->
    <camera name="vla_view" pos="1.2 -0.3 0.8" mode="targetbody" target="table" fovy="55"/>
  </worldbody>

  <keyframe>
    <!-- qpos length must equal nq = 9 (panda 7 + gripper 2) + 7 (box free joint: xyz + quat) = 16.
         Last 7 values place the box on top of the table (z = table_top 0.4 + box_half 0.02 = 0.42). -->
    <key name="grasp_home"
         qpos="0 -0.785 0 -2.356 0 1.571 0.785 0.04 0.04 0.5 0 0.42 1 0 0 0"/>
  </keyframe>
</mujoco>
